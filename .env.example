# ============================================================
# SGHSC — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env real no repositório.
# ============================================================

# Ambiente Flask: development | testing | production
# Em production, SESSION_COOKIE_SECURE=True é aplicado automaticamente (HTTPS).
FLASK_ENV=development
FLASK_APP=wsgi.py

# Segurança — gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROQUE_PARA_UM_VALOR_SECRETO_FORTE

# Banco de dados
POSTGRES_DB=sghsc
POSTGRES_USER=sghsc_user
POSTGRES_PASSWORD=TROQUE_PARA_SENHA_FORTE
DATABASE_URL=postgresql://sghsc_user:TROQUE_PARA_SENHA_FORTE@db:5432/sghsc

# Informações da instituição
INSTITUICAO_NOME=Santa Casa de Misericórdia de Pedralva
INSTITUICAO_CNES=           # Número CNES da unidade (obrigatório para DATASUS)
INSTITUICAO_CNPJ=           # CNPJ da Santa Casa
INSTITUICAO_CIDADE=Pedralva
INSTITUICAO_UF=MG

# Certificado digital (ICP-Brasil)
CERT_STORAGE_PATH=/app/certs
CERT_TIMESTAMP_URL=http://timestamp.safeweb.org.br

# Logs
LOG_FILE=logs/sghsc.log

# ------------------------------------------------------------
# Nginx / TLS (HTTPS)
# ------------------------------------------------------------
# development -> HTTP puro na porta 80 (sem HSTS) para o dev local
# production  -> porta 80 redireciona para 443 (HTTPS) + HSTS ativo
NGINX_ENV=development
# Domínio do certificado TLS em produção (ex.: sghsc.santacasapedralva.org.br)
NGINX_SERVER_NAME=_
# Em produção, monte os certificados TLS em nginx/certs/:
#   nginx/certs/fullchain.pem  e  nginx/certs/privkey.pem
# Ver docs/deploy-tls.md para provisionamento (arquivo próprio ou Let's Encrypt).
