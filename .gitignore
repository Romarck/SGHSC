# ============================================================
# SGHSC — .gitignore
# ============================================================

# Variáveis de ambiente (NUNCA commitar)
.env
*.env

# Certificados digitais (dados sensíveis)
backend/app/certs/
*.p12
*.pfx
*.pem
*.key
*.crt

# Certificados TLS do nginx (produção) — nunca commitar
# (mantém apenas os .gitkeep/README dos diretórios de montagem)
nginx/certs/*
!nginx/certs/.gitkeep
!nginx/certs/README.md

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/

# Virtualenv
venv/
env/
.venv/

# Flask
instance/
.flask_session/

# Uploads de usuários
backend/app/uploads/

# Logs
logs/
*.log

# Docker
.docker/

# IDEs
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Banco de dados local (SQLite em testes)
*.db
*.sqlite3

# Migrations (manter no repo, mas ignorar backups)
backend/migrations/versions/*.pyc
