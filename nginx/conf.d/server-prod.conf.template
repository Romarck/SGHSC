# ============================================================================
# Bloco de servidor — PRODUÇÃO
# Template processado por envsubst no entrypoint (substitui ${NGINX_SERVER_NAME}).
# Ativado quando NGINX_ENV=production.
#
# Comportamento:
#   - Porta 80 redireciona TODO tráfego para HTTPS (301) — exceto o desafio
#     ACME do Let's Encrypt (/.well-known/acme-challenge/).
#   - Porta 443 com TLS 1.2/1.3 e HSTS.
# ============================================================================

# ---- HTTP: redireciona para HTTPS (mantém ACME para Let's Encrypt) ----------
server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};

    # Permite a validação de domínio do Let's Encrypt sem HTTPS
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---- HTTPS: servidor principal ---------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    # Certificado TLS — montado via volume em /etc/nginx/certs
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # Apenas TLS 1.2+ (requisito da story: TLS 1.2+)
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # NOTA: cabeçalhos de segurança (HSTS + S-09) NÃO são colocados aqui no nível
    # do server, pois `add_header` não é herdado por locations que definem os
    # próprios `add_header`. São incluídos DENTRO de cada location abaixo.

    # Arquivos estáticos servidos diretamente pelo nginx (mais rápido)
    location /static/ {
        alias /static/;
        expires 7d;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/conf.d/security-headers.conf;
    }

    # Proxy para a aplicação Flask (Gunicorn)
    location / {
        proxy_pass         http://app:5000;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_redirect     off;

        # Suporte a HTMX (sem cache em respostas dinâmicas)
        add_header         Cache-Control "no-store, no-cache";
        include /etc/nginx/conf.d/security-headers.conf;
    }
}
